# Kopieer dit bestand naar .env en vul je eigen gegevens in.
# .env staat in .gitignore en wordt dus nooit mee gepubliceerd.

# =============================================================================
# 1. Je login op het ouderportaal
# =============================================================================
# Hetzelfde e-mailadres en wachtwoord als waarmee je zelf aanmeldt.
A4L_EMAIL=jouw.adres@voorbeeld.be
A4L_PASSWORD=jouw-portaalwachtwoord

# De school. Let op: de API gebruikt twee vormen van dezelfde code.
#   A4L_SCHOOL_ID   = de lange vorm, uit de header      (bv. lab_sn)
#   A4L_SCHOOL_CODE = de korte vorm, uit de login       (bv. sn)
# Laat A4L_SCHOOL_CODE leeg om ze af te leiden door "lab_" weg te halen.
# In de handleiding staat hoe je deze codes voor jouw school vindt.
A4L_SCHOOL_ID=lab_sn
A4L_SCHOOL_CODE=

# Enkel bepaalde kinderen volgen? Zet hier hun leerling-id's, gescheiden door
# komma's. Leeg = alle kinderen die aan je account hangen.
A4L_LEERLINGEN=

# Ook verwittigen als er een nieuw rapport gepubliceerd wordt (1 = ja, 0 = nee).
A4L_VOLG_RAPPORTEN=1

# Optioneel: de link onderaan de mail. Leeg = automatisch uit de schoolcode.
PORTAAL_URL=

# =============================================================================
# 2. Hoe de mail verstuurd wordt
# =============================================================================
# Elke SMTP-server werkt: die van je provider, van je werk, Gmail met een
# app-wachtwoord, of een verzenddienst zoals Mailgun of Brevo.
SMTP_HOST=smtp.jouwprovider.be
SMTP_PORT=587
# starttls (poort 587, gebruikelijk) | ssl (poort 465) | none
SMTP_SECURITY=starttls
SMTP_USER=verzender@jouwdomein.be
SMTP_PASSWORD=smtp-wachtwoord

# Afzender zoals hij in de mailbox verschijnt.
MAIL_FROM=verzender@jouwdomein.be
MAIL_FROM_NAAM=Resultatenwacht

# Ontvangers, gescheiden door komma's. Bijvoorbeeld beide ouders.
MAIL_TO=mama@voorbeeld.be,papa@voorbeeld.be

# Ook een mailtje krijgen als de controle zelf stukloopt (1 = ja).
MAIL_BIJ_FOUT=1

# =============================================================================
# 3. Wanneer er gecontroleerd wordt (alleen voor GitHub Actions)
# =============================================================================
# Deze drie worden als repository-variabelen gezet, niet als secret.
# MELD_UUR   : het uur in jouw tijdzone, 0 t/m 23. Meerdere mag: 8,16
# MELD_DAGEN : 1 = maandag ... 7 = zondag. Bijvoorbeeld 1,2,3,4,5 voor weekdagen.
MELD_UUR=16
MELD_DAGEN=1,2,3,4,5,6,7
TIJDZONE=Europe/Brussels

# =============================================================================
# 4. Overig
# =============================================================================
# Waar de lijst met "al gezien" resultaten bewaard wordt.
STATE_FILE=state.json

# =============================================================================
# 5. Kalendersync naar Google Agenda (optioneel, zie kalender.py)
# =============================================================================
# Welke soorten activiteiten je in je agenda wil. Beschikbaar zijn:
#   labAThome  - Lab@Home-dagen
#   lesvrij    - vrije dagen en verlof
#   evaluatie  - klassenraden, oudercontacten, rapporten, examendagen
#   uitstap    - uitstappen, voorstellingen, stages
#   infoavond  - infoavonden en lezingen voor ouders
#   melding    - algemene meldingen en themaweken
KALENDER_SOORTEN=labAThome,lesvrij,evaluatie,uitstap

# Ook activiteiten meenemen die voor de hele school gelden (1 = ja, 0 = nee).
KALENDER_SCHOOLBREED=1

# De voornaam van je kind voor de titel zetten, bv. "Sam: Daguitstap".
KALENDER_NAAM_IN_TITEL=1

# Items die van de schoolkalender verdwijnen ook uit je agenda halen.
KALENDER_OPRUIMEN=1

# Welk schooljaar. Leeg = automatisch het lopende schooljaar.
KALENDER_SCHOOLJAAR=

# De agenda waarin gesynchroniseerd wordt. Dit is het "agenda-ID" uit de
# instellingen van je Google Agenda, bv. abc123@group.calendar.google.com
GOOGLE_AGENDA_ID=

# De volledige inhoud van het JSON-sleutelbestand van je serviceaccount.
# Lokaal makkelijker: GOOGLE_SERVICE_ACCOUNT_JSON_FILE=sleutel.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Uur waarop de kalendersync draait op GitHub (standaard 6 uur 's ochtends).
KALENDER_UUR=6
